generator client {
  provider = "prisma-client-js"
}

enum PriceDerivationType {
  COST_MULTIPLIER
  TIER_PERCENTAGE
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PriceTier {
  id             String               @id @default(cuid())
  name           String               @unique
  isDefault      Boolean              @default(false)
  isActive       Boolean              @default(true)
  derivationType PriceDerivationType?
  costMultiplier Decimal?             @db.Decimal(12, 6)
  sourceTierId   String?
  percentage     Decimal?             @db.Decimal(12, 6)
  sourceTier     PriceTier?           @relation("TierDerivation", fields: [sourceTierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  derivedTiers   PriceTier[]          @relation("TierDerivation")
  companies      Company[]
  dishPrices     DishPrice[]
  optionPrices   OptionPrice[]

  @@index([isDefault, isActive])
}

model DishPrice {
  id     String    @id @default(cuid())
  dishId String
  tierId String
  price  Decimal   @db.Decimal(12, 2)
  dish   Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tier   PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([dishId, tierId])
}

model OptionPrice {
  id       String    @id @default(cuid())
  optionId String
  tierId   String
  price    Decimal   @db.Decimal(12, 2)
  option   Option    @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tier     PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([optionId, tierId])
}

model CompanyHiddenCategory {
  companyId  String
  categoryId String
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([companyId, categoryId])
}

model CompanyHiddenDish {
  companyId String
  dishId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dish      Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([companyId, dishId])
}

model CompanyHoliday {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  label     String?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([companyId, date])
}

enum UserRole {
  ADMIN
  KITCHEN
  DISPATCH
  DRIVER
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DishTemperature {
  HOT
  COLD
}

enum PackagingType {
  STANDARD
  INSULATED
  RECYCLABLE
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String
  role                UserRole
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  defaultForCompanies Company[] @relation("CompanyDefaultDriver")
}

model Allergen {
  id        String     @id @default(cuid())
  name      String     @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  dishes    Dish[]
  options   Option[]
  employees Employee[] @relation("EmployeeAllergies")

  @@index([isActive, name])
}

model DietaryTag {
  id        String     @id @default(cuid())
  name      String     @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  dishes    Dish[]
  options   Option[]
  employees Employee[] @relation("EmployeeDietaryPreferences")

  @@index([isActive, name])
}

model KitchenStation {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dishes    Dish[]

  @@index([isActive, name])
}

model Company {
  id                          String                   @id @default(cuid())
  name                        String
  externalId                  String?                  @unique
  billingContactName          String?
  billingContactEmail         String?
  billingContactPhone         String?
  ownerEmployeeId             String?
  defaultDeliveryTime         String?                  @db.VarChar(5)
  kitchenDepartureLeadMinutes Int                      @default(60)
  defaultPackaging            PackagingType            @default(STANDARD)
  driverInstructions          String?
  defaultDriverId             String?
  defaultDeliveryAddressId    String?
  isActive                    Boolean                  @default(true)
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  employees                   Employee[]
  ownerEmployee               Employee?                @relation("CompanyOwner", fields: [ownerEmployeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  defaultDriver               User?                    @relation("CompanyDefaultDriver", fields: [defaultDriverId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  emailDomains                CompanyEmailDomain[]
  deliveryAddresses           CompanyDeliveryAddress[]
  orders                      Order[]
  priceTierId                 String?
  priceTier                   PriceTier?               @relation(fields: [priceTierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  workingDays                 Json                     @default("[1,2,3,4,5]")
  holidays                    CompanyHoliday[]
  hiddenCategories            CompanyHiddenCategory[]
  hiddenDishes                CompanyHiddenDish[]
  defaultDeliveryAddress      CompanyDeliveryAddress?  @relation("CompanyDefaultDeliveryAddress", fields: [defaultDeliveryAddressId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([isActive])
}

model Employee {
  id                          String       @id @default(cuid())
  companyId                   String
  name                        String
  email                       String?
  phone                       String?
  canChooseOwnDeliveryAddress Boolean      @default(false)
  canChangeDeliveryTime       Boolean      @default(false)
  canChangePackaging          Boolean      @default(false)
  isActive                    Boolean      @default(true)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  company                     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ownedCompanies              Company[]    @relation("CompanyOwner")
  orders                      Order[]
  allergies                   Allergen[]   @relation("EmployeeAllergies")
  dietaryPreferences          DietaryTag[] @relation("EmployeeDietaryPreferences")

  @@index([companyId, isActive])
  @@index([email])
}

model Dish {
  id                   String              @id @default(cuid())
  name                 String
  description          String?
  image                String?
  sku                  String              @unique
  temperature          DishTemperature
  costPrice            Decimal             @map("price") @db.Decimal(12, 2)
  minimumOrderQuantity Int?
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  orderLines           OrderLine[]
  options              Option[]
  allergens            Allergen[]
  dietaryTags          DietaryTag[]
  kitchenStation       KitchenStation?     @relation(fields: [kitchenStationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  kitchenStationId     String?
  optionGroups         OptionGroup[]
  categoryMemberships  MenuCategoryDish[]
  prices               DishPrice[]
  hiddenForCompanies   CompanyHiddenDish[]

  @@index([isActive, name])
  @@index([temperature, isActive])
}

model MenuCategory {
  id                 String                  @id @default(cuid())
  name               String
  displayOrder       Int
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  dishes             MenuCategoryDish[]
  secret             Boolean                 @default(false)
  hiddenForCompanies CompanyHiddenCategory[]

  @@unique([displayOrder])
  @@index([isActive, displayOrder])
}

model MenuCategoryDish {
  id           String       @id @default(cuid())
  categoryId   String
  dishId       String
  displayOrder Int
  isActive     Boolean      @default(true)
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dish         Dish         @relation(fields: [dishId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([categoryId, dishId])
  @@unique([categoryId, displayOrder])
  @@index([dishId])
}

model CompanyEmailDomain {
  id        String   @id @default(cuid())
  companyId String
  domain    String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
}

model CompanyDeliveryAddress {
  id                  String    @id @default(cuid())
  companyId           String
  label               String
  addressLine1        String
  addressLine2        String?
  city                String
  state               String?
  postalCode          String
  country             String    @default("US")
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orders              Order[]
  defaultForCompanies Company[] @relation("CompanyDefaultDeliveryAddress")

  @@index([companyId, isActive])
}

model Option {
  id          String              @id @default(cuid())
  name        String
  cost        Decimal             @map("priceAdjustment") @db.Decimal(12, 2)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  dishes      Dish[]
  orderLines  OrderLine[]
  allergens   Allergen[]
  dietaryTags DietaryTag[]
  groupLinks  OptionGroupOption[]
  prices      OptionPrice[]

  @@index([isActive, name])
}

model OptionGroup {
  id           String               @id @default(cuid())
  dishId       String
  name         String
  isRequired   Boolean              @default(false)
  displayOrder Int
  usesPortions Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  dish         Dish                 @relation(fields: [dishId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  options      OptionGroupOption[]
  portions     OptionGroupPortion[]

  @@unique([dishId, displayOrder])
  @@index([dishId, displayOrder])
}

model OptionGroupOption {
  id           String                     @id @default(cuid())
  groupId      String
  optionId     String
  displayOrder Int
  group        OptionGroup                @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  option       Option                     @relation(fields: [optionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  portions     OptionGroupOptionPortion[]

  @@unique([groupId, optionId])
  @@unique([groupId, displayOrder])
  @@index([optionId])
}

model PortionSize {
  id        String               @id @default(cuid())
  name      String               @unique
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  groups    OptionGroupPortion[]

  @@index([isActive, name])
}

model OptionGroupPortion {
  id            String                     @id @default(cuid())
  groupId       String
  portionSizeId String
  displayOrder  Int
  extraCharge   Decimal                    @db.Decimal(12, 2)
  group         OptionGroup                @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  portionSize   PortionSize                @relation(fields: [portionSizeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  options       OptionGroupOptionPortion[]

  @@unique([groupId, portionSizeId])
  @@unique([groupId, displayOrder])
}

model OptionGroupOptionPortion {
  optionGroupOptionId  String
  optionGroupPortionId String
  optionGroupOption    OptionGroupOption  @relation(fields: [optionGroupOptionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  optionGroupPortion   OptionGroupPortion @relation(fields: [optionGroupPortionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([optionGroupOptionId, optionGroupPortionId])
}

model Order {
  id                      String                  @id @default(cuid())
  employeeId              String
  companyId               String
  status                  OrderStatus             @default(DRAFT)
  employeeNameSnapshot    String
  companyNameSnapshot     String
  deliveryDetails         Json?
  deliveryAddressId       String?
  deliveryAddressSnapshot Json?
  serviceDate             DateTime
  total                   Decimal                 @db.Decimal(12, 2)
  placedAt                DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  employee                Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deliveryAddress         CompanyDeliveryAddress? @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines                   OrderLine[]

  @@index([employeeId, createdAt])
  @@index([companyId, createdAt])
  @@index([status, serviceDate])
  @@index([serviceDate])
}

model OrderLine {
  id                      String   @id @default(cuid())
  orderId                 String
  dishId                  String
  dishNameSnapshot        String
  quantity                Int
  unitPrice               Decimal  @db.Decimal(12, 2)
  lineTotal               Decimal  @db.Decimal(12, 2)
  selectedOptionsSnapshot Json?
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  order                   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dish                    Dish     @relation(fields: [dishId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  options                 Option[]

  @@index([orderId])
  @@index([dishId])
}
