generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  KITCHEN
  DISPATCH
  DRIVER
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DishTemperature {
  HOT
  COLD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Allergen {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dishes    Dish[]
  options   Option[]

  @@index([isActive, name])
}

model DietaryTag {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dishes    Dish[]
  options   Option[]

  @@index([isActive, name])
}

model KitchenStation {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dishes    Dish[]

  @@index([isActive, name])
}

model Company {
  id                  String                   @id @default(cuid())
  name                String
  externalId          String?                  @unique
  billingContactName  String?
  billingContactEmail String?
  billingContactPhone String?
  ownerEmployeeId     String?
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  employees           Employee[]
  ownerEmployee       Employee?                @relation("CompanyOwner", fields: [ownerEmployeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  emailDomains        CompanyEmailDomain[]
  deliveryAddresses   CompanyDeliveryAddress[]
  orders              Order[]

  @@index([isActive])
}

model Employee {
  id             String    @id @default(cuid())
  companyId      String
  name           String
  email          String?
  phone          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ownedCompanies Company[] @relation("CompanyOwner")
  orders         Order[]

  @@index([companyId, isActive])
  @@index([email])
}

model Dish {
  id                   String             @id @default(cuid())
  name                 String
  description          String?
  image                String?
  sku                  String             @unique
  temperature          DishTemperature
  costPrice            Decimal            @map("price") @db.Decimal(12, 2)
  minimumOrderQuantity Int?
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  orderLines           OrderLine[]
  options              Option[]
  allergens            Allergen[]
  dietaryTags          DietaryTag[]
  kitchenStation       KitchenStation?    @relation(fields: [kitchenStationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  kitchenStationId     String?
  optionGroups         OptionGroup[]
  categoryMemberships  MenuCategoryDish[]

  @@index([isActive, name])
  @@index([temperature, isActive])
}

model MenuCategory {
  id           String             @id @default(cuid())
  name         String
  displayOrder Int
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  dishes       MenuCategoryDish[]

  @@unique([displayOrder])
  @@index([isActive, displayOrder])
}

model MenuCategoryDish {
  id           String       @id @default(cuid())
  categoryId   String
  dishId       String
  displayOrder Int
  isActive     Boolean      @default(true)
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dish         Dish         @relation(fields: [dishId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([categoryId, dishId])
  @@unique([categoryId, displayOrder])
  @@index([dishId])
}

model CompanyEmailDomain {
  id        String   @id @default(cuid())
  companyId String
  domain    String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
}

model CompanyDeliveryAddress {
  id           String   @id @default(cuid())
  companyId    String
  label        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String   @default("US")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orders       Order[]

  @@index([companyId, isActive])
}

model Option {
  id          String              @id @default(cuid())
  name        String
  cost        Decimal             @map("priceAdjustment") @db.Decimal(12, 2)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  dishes      Dish[]
  orderLines  OrderLine[]
  allergens   Allergen[]
  dietaryTags DietaryTag[]
  groupLinks  OptionGroupOption[]

  @@index([isActive, name])
}

model OptionGroup {
  id           String               @id @default(cuid())
  dishId       String
  name         String
  isRequired   Boolean              @default(false)
  displayOrder Int
  usesPortions Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  dish         Dish                 @relation(fields: [dishId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  options      OptionGroupOption[]
  portions     OptionGroupPortion[]

  @@unique([dishId, displayOrder])
  @@index([dishId, displayOrder])
}

model OptionGroupOption {
  id           String                     @id @default(cuid())
  groupId      String
  optionId     String
  displayOrder Int
  group        OptionGroup                @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  option       Option                     @relation(fields: [optionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  portions     OptionGroupOptionPortion[]

  @@unique([groupId, optionId])
  @@unique([groupId, displayOrder])
  @@index([optionId])
}

model PortionSize {
  id        String               @id @default(cuid())
  name      String               @unique
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  groups    OptionGroupPortion[]

  @@index([isActive, name])
}

model OptionGroupPortion {
  id            String                     @id @default(cuid())
  groupId       String
  portionSizeId String
  displayOrder  Int
  extraCharge   Decimal                    @db.Decimal(12, 2)
  group         OptionGroup                @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  portionSize   PortionSize                @relation(fields: [portionSizeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  options       OptionGroupOptionPortion[]

  @@unique([groupId, portionSizeId])
  @@unique([groupId, displayOrder])
}

model OptionGroupOptionPortion {
  optionGroupOptionId  String
  optionGroupPortionId String
  optionGroupOption    OptionGroupOption  @relation(fields: [optionGroupOptionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  optionGroupPortion   OptionGroupPortion @relation(fields: [optionGroupPortionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([optionGroupOptionId, optionGroupPortionId])
}

model Order {
  id                      String                  @id @default(cuid())
  employeeId              String
  companyId               String
  status                  OrderStatus             @default(DRAFT)
  employeeNameSnapshot    String
  companyNameSnapshot     String
  deliveryDetails         Json?
  deliveryAddressId       String?
  deliveryAddressSnapshot Json?
  serviceDate             DateTime
  total                   Decimal                 @db.Decimal(12, 2)
  placedAt                DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  employee                Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company                 Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deliveryAddress         CompanyDeliveryAddress? @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines                   OrderLine[]

  @@index([employeeId, createdAt])
  @@index([companyId, createdAt])
  @@index([status, serviceDate])
  @@index([serviceDate])
}

model OrderLine {
  id                      String   @id @default(cuid())
  orderId                 String
  dishId                  String
  dishNameSnapshot        String
  quantity                Int
  unitPrice               Decimal  @db.Decimal(12, 2)
  lineTotal               Decimal  @db.Decimal(12, 2)
  selectedOptionsSnapshot Json?
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  order                   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dish                    Dish     @relation(fields: [dishId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  options                 Option[]

  @@index([orderId])
  @@index([dishId])
}
